{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Trynext Studio visual language in the W3C Design Tokens (DTCG) format. This file is the single source of truth: edit it, then regenerate the web theme and portable tokens. It pairs warm orange purchase actions with Bangladesh-green trust accents, premium warm surfaces, and rounded product cards. Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fffdfb" },
      "foreground": { "$value": "#21170f" },
      "border": { "$value": "#eadfd6" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#21170f" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#21170f" },
      "primary": {
        "$value": "#e85d04",
        "$description": "Trynext orange. Drives purchase actions, links, active navigation, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#fff3e8" },
      "secondaryForeground": { "$value": "#9a3412" },
      "muted": { "$value": "#f6f0eb" },
      "mutedForeground": { "$value": "#75685f" },
      "accent": { "$value": "#eaf7f2" },
      "accentForeground": { "$value": "#00523c" },
      "destructive": { "$value": "#dc3c35" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#f1e8e1" },
      "ring": { "$value": "#e85d04" },
      "chart1": { "$value": "#e85d04" },
      "chart2": { "$value": "#006a4e" },
      "chart3": { "$value": "#1c2951" },
      "chart4": { "$value": "#f59e0b" },
      "chart5": { "$value": "#db2777" },
      "sidebar": { "$value": "#171411" },
      "sidebarForeground": { "$value": "#fff7f0" },
      "sidebarBorder": { "$value": "#3b3029" },
      "sidebarPrimary": { "$value": "#fb8500" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#2b211b" },
      "sidebarAccentForeground": { "$value": "#ffcfaa" },
      "sidebarRing": { "$value": "#ffb066" }
    },
    "dark": {
      "background": { "$value": "#171411" },
      "foreground": { "$value": "#fff7f0" },
      "border": { "$value": "#49382e" },
      "card": { "$value": "#211a15" },
      "cardForeground": { "$value": "#fff7f0" },
      "popover": { "$value": "#211a15" },
      "popoverForeground": { "$value": "#fff7f0" },
      "primary": { "$value": "#fb8500" },
      "primaryForeground": { "$value": "#321400" },
      "secondary": { "$value": "#3a281e" },
      "secondaryForeground": { "$value": "#ffe4cf" },
      "muted": { "$value": "#2b211b" },
      "mutedForeground": { "$value": "#cbb5a6" },
      "accent": { "$value": "#174f41" },
      "accentForeground": { "$value": "#e5fff6" },
      "destructive": { "$value": "#f06a5f" },
      "destructiveForeground": { "$value": "#2b0b08" },
      "input": { "$value": "#3a2b22" },
      "ring": { "$value": "#ffb066" },
      "chart1": { "$value": "#fb8500" },
      "chart2": { "$value": "#33b58b" },
      "chart3": { "$value": "#8195d8" },
      "chart4": { "$value": "#fbbf24" },
      "chart5": { "$value": "#f472b6" },
      "sidebar": { "$value": "#100e0c" },
      "sidebarForeground": { "$value": "#fff7f0" },
      "sidebarBorder": { "$value": "#30251e" },
      "sidebarPrimary": { "$value": "#fb8500" },
      "sidebarPrimaryForeground": { "$value": "#321400" },
      "sidebarAccent": { "$value": "#2b211b" },
      "sidebarAccentForeground": { "$value": "#ffcfaa" },
      "sidebarRing": { "$value": "#ffb066" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Plus Jakarta Sans", "sans-serif"],
        "$description": "Default UI and body typeface: approachable, clear, and high-legibility."
      },
      "heading": {
        "$value": ["Outfit", "sans-serif"],
        "$description": "Display and heading typeface: expressive, compact, and product-forward."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; controls stay friendly and product cards can step up to larger rounded surfaces."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step; use the 4px rhythm and generous section padding for a premium retail feel."
    }
  }
}
