{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Trynext Atelier Commerce tokens for premium print-on-demand creation, publishing, and shopping surfaces. Warm editorial neutrals pair with a focused orange action color and an olive trust accent.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fbf7f1" },
      "foreground": { "$value": "#241d17" },
      "card": { "$value": "#fffdf9" },
      "cardForeground": { "$value": "#241d17" },
      "popover": { "$value": "#fffdf9" },
      "popoverForeground": { "$value": "#241d17" },
      "primary": { "$value": "#d9652d", "$description": "Warm orange reserved for the single next action, active state, and purchase emphasis." },
      "primaryForeground": { "$value": "#fffaf5" },
      "secondary": { "$value": "#f1e5d8" },
      "secondaryForeground": { "$value": "#754128" },
      "muted": { "$value": "#f3ede6" },
      "mutedForeground": { "$value": "#786b61" },
      "accent": { "$value": "#e0ebe2", "$description": "Olive-sage trust surface for verified, ready, and healthy states." },
      "accentForeground": { "$value": "#27483a" },
      "destructive": { "$value": "#b54840" },
      "destructiveForeground": { "$value": "#fff8f5" },
      "border": { "$value": "#e6d8ca" },
      "input": { "$value": "#ded0c2" },
      "ring": { "$value": "#d9652d" },
      "chart1": { "$value": "#d9652d" },
      "chart2": { "$value": "#4f7a61" },
      "chart3": { "$value": "#2d425d" },
      "chart4": { "$value": "#c89137" },
      "chart5": { "$value": "#b96678" },
      "sidebar": { "$value": "#211b17" },
      "sidebarForeground": { "$value": "#fff8f1" },
      "sidebarBorder": { "$value": "#40342b" },
      "sidebarPrimary": { "$value": "#ed8a50" },
      "sidebarPrimaryForeground": { "$value": "#2e170d" },
      "sidebarAccent": { "$value": "#322923" },
      "sidebarAccentForeground": { "$value": "#f6d3b9" },
      "sidebarRing": { "$value": "#f4a875" }
    },
    "dark": {
      "background": { "$value": "#171310" },
      "foreground": { "$value": "#fff8f1" },
      "card": { "$value": "#211a16" },
      "cardForeground": { "$value": "#fff8f1" },
      "popover": { "$value": "#211a16" },
      "popoverForeground": { "$value": "#fff8f1" },
      "primary": { "$value": "#ed8a50" },
      "primaryForeground": { "$value": "#35170c" },
      "secondary": { "$value": "#3a2b22" },
      "secondaryForeground": { "$value": "#f7d1b8" },
      "muted": { "$value": "#2b231e" },
      "mutedForeground": { "$value": "#c8b7a9" },
      "accent": { "$value": "#294c3d" },
      "accentForeground": { "$value": "#e7f6ea" },
      "destructive": { "$value": "#db6d63" },
      "destructiveForeground": { "$value": "#34100d" },
      "border": { "$value": "#493a2f" },
      "input": { "$value": "#3a2d24" },
      "ring": { "$value": "#f4a875" },
      "chart1": { "$value": "#ed8a50" },
      "chart2": { "$value": "#79aa88" },
      "chart3": { "$value": "#8ca6cd" },
      "chart4": { "$value": "#e2b65d" },
      "chart5": { "$value": "#db91a1" },
      "sidebar": { "$value": "#100d0b" },
      "sidebarForeground": { "$value": "#fff8f1" },
      "sidebarBorder": { "$value": "#332821" },
      "sidebarPrimary": { "$value": "#ed8a50" },
      "sidebarPrimaryForeground": { "$value": "#35170c" },
      "sidebarAccent": { "$value": "#2b211b" },
      "sidebarAccentForeground": { "$value": "#f6d3b9" },
      "sidebarRing": { "$value": "#f4a875" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Plus Jakarta Sans", "sans-serif"], "$description": "Clear, warm UI and body type for retail and creator workflows." },
      "serif": { "$value": ["Playfair Display", "Georgia", "serif"], "$description": "Editorial display voice for product stories and premium moments." },
      "mono": { "$value": ["JetBrains Mono", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.75rem", "$description": "Friendly base radius; use larger steps for product imagery and creator panels." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Four-pixel rhythm with generous editorial section spacing." }
  }
}